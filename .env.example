GIT_PROGRESSOR_DATA_DIR=./data
GIT_PROGRESSOR_DATABASE_URL=sqlite:///./data/git-progressor.db
GIT_PROGRESSOR_LOG_LEVEL=INFO
# Supply OPENAI_API_KEY through the process environment, never commit it.
# Choose a model with Responses API structured-output support before live planning.
# GIT_PROGRESSOR_OPENAI_MODEL=your-selected-model
GIT_PROGRESSOR_OPENAI_MAX_OUTPUT_TOKENS=8192
GIT_PROGRESSOR_OPENAI_TIMEOUT_SECONDS=120

