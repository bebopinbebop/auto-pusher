[Unit]
Description=Git Progressor deterministic publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=git-progressor
Group=git-progressor
WorkingDirectory=/opt/git-progressor
EnvironmentFile=/etc/git-progressor/environment
ExecStart=/opt/git-progressor/.venv/bin/git-progressor worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/git-progressor

[Install]
WantedBy=multi-user.target

